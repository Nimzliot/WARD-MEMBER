# Copy to .env and fill in. NEVER commit .env.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role (or "secret") key — server only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fast2SMS → Dev API → API key (not needed when DEV_MODE=true)
FAST2SMS_API_KEY=your-fast2sms-api-key

# Long random string used to anonymise voters: voter_hash = SHA-256(user_id + VOTE_SALT)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it after votes exist, or the same person gets a new voter_hash.
VOTE_SALT=change-me-to-a-long-random-string

# true  → OTP is printed to this console instead of being sent by SMS (free testing)
# false → real SMS through Fast2SMS
DEV_MODE=true

PORT=3000

# Optional — only used by `npm run token` (test helper that logs you in by email OTP)
SUPABASE_ANON_KEY=your-anon-key

# Google AI Studio key (https://aistudio.google.com/apikey) — enables Ward Assistant AI features
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# tried in order when the main model is rate-limited
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite

# Razorpay → Dashboard (Test Mode) → Settings → API Keys. Use TEST keys (rzp_test_...) only.
# Enables ward fundraising. Payments are demo payments; no real money moves.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret

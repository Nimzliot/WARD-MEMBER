# Copy to .env and fill in. NEVER commit .env.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role (or "secret") key — server only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fast2SMS → Dev API → API key (not needed when DEV_MODE=true)
FAST2SMS_API_KEY=your-fast2sms-api-key

# Long random string used to anonymise voters: voter_hash = SHA-256(user_id + VOTE_SALT)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it after votes exist, or the same person gets a new voter_hash.
VOTE_SALT=change-me-to-a-long-random-string

# true  → OTP is printed to this console instead of being sent by SMS (free testing)
# false → real SMS through Fast2SMS
DEV_MODE=true

PORT=3000

# Optional — only used by `npm run token` (test helper that logs you in by email OTP)
SUPABASE_ANON_KEY=your-anon-key
